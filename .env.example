NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_research_assistant
CORS_ORIGIN=*
LOG_LEVEL=debug

# JWT & Auth Configuration
JWT_ACCESS_SECRET=dev_access_secret_key_change_in_production_2026
JWT_REFRESH_SECRET=dev_refresh_secret_key_change_in_production_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Document Uploads & Cloudinary Object Storage Configuration
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=ai_research_assistant
PRESIGNED_URL_EXPIRES_SECONDS=900
MAX_FILE_SIZE_BYTES=26214400
MAX_FILES_PER_UPLOAD=10

# Fallback Local Object Storage (used when STORAGE_PROVIDER=local)
LOCAL_STORAGE_DIR=storage/objects
STORAGE_SIGNING_SECRET=dev_storage_presigned_url_secret_2026

# Gemini AI & Embeddings Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-2.5-flash
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RAG_MAX_CONTEXT_CHUNKS=6
RAG_MIN_SIMILARITY_SCORE=0.60


